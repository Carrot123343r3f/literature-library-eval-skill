{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/literature-library-eval/artifact-manifest.schema.json",
  "title": "Workflow artifact lineage record",
  "type": "object",
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "size", "producer", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "producer": {"type": "string", "minLength": 1},
        "kind": {"enum": ["input", "output", "checkpoint"]}
      }
    }
  }
}
