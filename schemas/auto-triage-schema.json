{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-assisted triage suggestions",
  "type": "object",
  "required": ["schema_version", "status", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "suggestions_only"},
    "generated_at": {"type": "string"},
    "note": {"type": "string"},
    "items": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "suggestion", "confidence", "final_decision"], "properties": {"candidate_id": {"type": "string"}, "title": {"type": "string"}, "source": {"type": ["string", "null"]}, "suggestion": {"enum": ["include_review", "exclude_review", "human_review"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "reasons": {"type": "object"}, "final_decision": {"const": "pending"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
